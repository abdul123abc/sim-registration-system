# backend/.env.example
# Copy this to .env and fill in values after Milestone 2 brings the network up.

# Fabric peer gRPC endpoint
PEER_ENDPOINT=peer0.ncc.example.com:7051

# TLS certificate of the peer
TLS_CERT_PATH=../network/crypto-config/peerOrganizations/ncc.example.com/peers/peer0.ncc.example.com/tls/ca.crt

# Client identity (Admin of NCC org)
CLIENT_CERT_PATH=../network/crypto-config/peerOrganizations/ncc.example.com/users/Admin@ncc.example.com/msp/signcerts/cert.pem
CLIENT_KEY_PATH=../network/crypto-config/peerOrganizations/ncc.example.com/users/Admin@ncc.example.com/msp/keystore/priv_sk

# MSP ID of the connecting organisation
MSP_ID=NCCMSP

# IPFS Kubo API. In Docker, use the Compose service name.
IPFS_API_URL=http://ipfs:5001
IPFS_TIMEOUT_MS=15000
IPFS_ALLOW_FALLBACK=false

# Express port
PORT=3001
