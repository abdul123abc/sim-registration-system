# network/docker/.env
# Environment variables consumed by docker-compose.yaml
# Chapter Three, Section 3.4 — Fabric v2.5

COMPOSE_PROJECT_NAME=sim-blockchain
FABRIC_VERSION=2.5.7
CA_VERSION=1.5.9
COUCHDB_VERSION=3.3.3

# Channel name — must match the configtx.yaml profile key
CHANNEL_NAME=sim-registration-channel

# Base domain
DOMAIN=example.com
